-- 2) target = unit sejenis yang benar-benar bisa di-merge (CanMerge=true), terdekat
local function nearestSame(cm, ckey, cid, cur)
	if not canPair(cid) then return nil, true end
	local list = plotModels()
	local f = frontPos()
	local best, bd, anySame
	for _, m in ipairs(list) do
		local k = m:GetAttribute("BrainrotKey")
		if m ~= cm and k ~= ckey and m:GetAttribute("BrainrotId") == cid then
			anySame = true
			if canMergeKeys(ckey, k) then
				local d = f and xz(f, probeOf(m)) or 0
				if not bd or d < bd then best, bd = m, d end
			end
		end
	end
	if cur and cur.Parent and best and cur ~= best and f then
		local ck = cur:GetAttribute("BrainrotKey")
		if canMergeKeys(ckey, ck) and xz(f, probeOf(cur)) <= bd + 4 then return cur, anySame end
	end
	return best, anySame
end

local function noTargetReason(cid, anySame)
	if not canPair(cid) then return "level tertinggi" end
	if anySame then return "diblokir (rebirth/terkunci)" end
	return "tanpa pasangan"
end

-- 3) jalan ke target; merge dengan unit sejenis mana pun yang tersentuh sah
local function goMerge(cm, ckey, cid, my, v)
	local tkeys, touches, conns = {}, {}, {}
	for _, part in ipairs(cm:GetDescendants()) do
		if part:IsA("BasePart") then
			conns[#conns + 1] = part.Touched:Connect(function(o)
				local u = unitOf(o)
				if u and u ~= cm then
					local k = u:GetAttribute("BrainrotKey")
					if typeof(k) == "string" and not tkeys[k] then
						tkeys[k] = true
						touches[#touches + 1] = ("%s(%s)"):format(short(k), tostring(u:GetAttribute("BrainrotId")))
					end
				end
			end)
		end
	end
	local function finish(ok, why)
		for _, c in ipairs(conns) do c:Disconnect() end
		return ok, tkeys, touches, why
	end

	local target, noTargetSince
	local t0, lastPick = os.clock(), 0
	local inRangeSince, turns = nil, 0
	local teleFor, forceTele = nil, false
	setStep("cari target sejenis")
	while os.clock() - t0 < 20 do
		if not live(my) then return finish(false, "dibatalkan") end
		if carryAttr() == nil then return finish(true) end
		if os.clock() - lastPick > 0.5 then
			lastPick = os.clock()
			local nt, anySame = nearestSame(cm, ckey, cid, target)
			if nt ~= target then
				target = nt
				if target then
					L(v, ("  target %s"):format(short(target:GetAttribute("BrainrotKey"))))
					setStep("jalan ke target " .. short(target:GetAttribute("BrainrotKey")))
				end
			end
			if not target then
				noTargetSince = noTargetSince or os.clock()
				if os.clock() - noTargetSince > 1.2 then
					return finish(false, noTargetReason(cid, anySame))
				end
			else
				noTargetSince = nil
			end
		end
		if target then
			local pr = probeOf(target)
			local f = frontPos()
			local d = f and xz(f, pr) or 99
			local R = radiusOf(cm) + radiusOf(target)
			if mode == "tele" and ((teleFor ~= target and d > R + 1.5) or forceTele) then
				teleFor, forceTele = target, false
				local sp, pen = standPoint(pr, R + 1.5, target, cm, turns)
				teleportTo(sp, pr, ("ke target %s pen=%d"):format(short(target:GetAttribute("BrainrotKey")), pen or 0))
				f = frontPos()
				d = f and xz(f, pr) or 99
			end
			local h = humOf()
			if not h then return finish(false, "tidak ada humanoid") end
			local hr = hrpOf()
			local y = hr and hr.Position.Y or pr.Y
			if d <= R then
				inRangeSince = inRangeSince or os.clock()
				if os.clock() - inRangeSince > 0.6 then
					turns = turns + 1
					local tk = target:GetAttribute("BrainrotKey")
					say(("  dekat tapi belum merge (d=%.1f R=%.1f canMerge=%s), mundur lalu masuk lagi #%d"):format(
						d, R, tostring(canMergeKeys(ckey, tk)), turns))
					if turns >= 6 then return finish(false, "sentuhan tidak memicu merge") end
					if mode == "tele" then
						forceTele = true
					else
						local dir = f and Vector3.new(f.X - pr.X, 0, f.Z - pr.Z) or Vector3.new(0, 0, 1)
						dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
						local ang = ((turns % 2 == 1) and 1 or -1) * math.rad(35 * math.ceil(turns / 2))
						local cs, sn = math.cos(ang), math.sin(ang)
						local rot = Vector3.new(dir.X * cs - dir.Z * sn, 0, dir.X * sn + dir.Z * cs)
						walkTo(pr + rot * (R + 3), 1, 2, function() return carryAttr() == nil end, my, "mundur")
					end
					inRangeSince = nil
				else
					h:MoveTo(Vector3.new(pr.X, y, pr.Z))
				end
			else
				inRangeSince = nil
				h:MoveTo(Vector3.new(pr.X, y, pr.Z))
			end
		end
		task.wait(0.1)
	end
	return finish(carryAttr() == nil, "timeout 20 detik")
end

-- MODE FULL: langsung remote MergePlot(unit dibawa, unit sejenis), tanpa gerak
local function fullMerge(cm, ckey, cid, my, v)
	local function fin(ok, why) return ok, {}, {}, why end
	setStep("FULL merge " .. short(ckey))
	local tried = {}
	for _ = 1, 3 do
		if not live(my) then return fin(false, "dibatalkan") end
		if carryAttr() == nil then return fin(true) end
		local tgt, anySame
		local t0 = os.clock()
		repeat
			tgt = nil
			for _, m in ipairs((plotModels())) do
				local k = m:GetAttribute("BrainrotKey")
				if m ~= cm and k ~= ckey and not tried[k] and m:GetAttribute("BrainrotId") == cid then
					anySame = true
					if canMergeKeys(ckey, k) then tgt = m break end
				end
			end
			if not tgt then task.wait(0.15) end
		until tgt or os.clock() - t0 > 1.2 or not live(my)
		if not tgt then return fin(false, noTargetReason(cid, anySame)) end
		local tk = tgt:GetAttribute("BrainrotKey")
		tried[tk] = true
		local res = table.pack(invoke(5, "MergePlot", ckey, tk))
		mv(("  REMOTE MergePlot(%s,%s) -> %s"):format(short(ckey), short(tk), argstr(res)))
		local t1 = os.clock()
		while os.clock() - t1 < 2 and carryAttr() do task.wait(0.1) end
		if carryAttr() == nil then
			fullFail = 0
			return fin(true)
		end
	end
	return fin(false, "server menolak MergePlot")
end

-- ===== lepas unit =====
local homePos

local function dropAndLeave(my)
	setStep("DropOff")
	if carryAttr() == nil then
		if carriedRaw() then
			say("  sisa visual unit, dibersihkan")
			cleanStale()
		end
		return true
	end
	for attempt = 1, 4 do
		local okd, rd = invoke(6, "DropOff")
		local t0 = os.clock()
		while os.clock() - t0 < 1.5 and carryAttr() do task.wait(0.1) end
		local a = carryAttr()
		say(("  DropOff #%d ok=%s r=%s | attr=%s model=%s"):format(
			attempt, tostring(okd), tostring(rd), a and short(a) or "nil", carriedRaw() and "ada" or "nil"))
		if not a then
			drops = drops + 1
			if carriedRaw() then
				say("  sisa visual unit, dibersihkan")
				cleanStale()
			end
			if mode == "walk" then
				local h = hrpOf()
				if h then walkTo(h.Position - h.CFrame.LookVector * 4, 1.5, 1.5, nil, my, "menjauh") end
			end
			return true
		end
		if attempt == 2 and homePos and mode ~= "full" then
			setStep("ke titik awal")
			walkTo(homePos, 3, 6, nil, my, "titik awal")
			setStep("DropOff")
		end
		task.wait(1.0)
		if not alive(my) then return false end
	end
	say("  unit MASIH terbawa setelah 4x DropOff")
	return false
end

-- ===== verifikasi merge: satu pekerja untuk semua =====
local vq, vrun = {}, false
local function queueVerify(item)
	vq[#vq + 1] = item
	if vrun then return end
	vrun = true
	task.spawn(function()
		while #vq > 0 and env.AM_GEN == gen do
			local now, n = os.clock(), unitCount()
			for i = #vq, 1, -1 do
				local it = vq[i]
				local gone = it.hadRec and getRec(it.ckey) == nil
				if gone or (n ~= -1 and it.before ~= -1 and n < it.before) then
					total = total + 1
					table.remove(vq, i)
				elseif now - it.t0 > 8 then
					say(("perhatian: %s belum terverifikasi (unit %s -> %s)"):format(short(it.ckey), tostring(it.before), tostring(n)))
					table.remove(vq, i)
				end
			end
			task.wait(0.5)
		end
		vrun = false
	end)
end

-- ===== satu siklus. return: ok, alasan, fatal, soft =====
local function cycle(mA, my, v, sync)
	local before = unitCount()
	local t00 = os.clock()
	goal = nil
	if carryAttr() == nil and carriedRaw() then
		say("  ada sisa visual unit, dibersihkan")
		cleanStale()
		task.wait(0.3)
	end
	local cm = carried()
	if not cm and carryAttr() then
		say("  server mencatat ada unit terbawa tapi modelnya tidak ada, dilepas")
		if not dropAndLeave(my) then return false, "unit terbawa tidak bisa dilepas", true end
	end
	local fresh = false
	if not cm then
		if not (mA and mA.Parent) then return false, "unit hilang", false, true end
		if mode == "full" then
			cm = fullPickup(mA, my, v)
		elseif mode == "tele" then
			cm = telePickup(mA, my, v)
		else
			cm = pickUp(mA, my, v)
		end
		if not cm then
			if mode == "full" then
				fullFail = fullFail + 1
				if fullFail >= 3 then
					say("FULL ditolak server 3x (PickUpPlot tanpa dekat), turun ke mode TELE")
					setMode("tele")
				end
			end
			return false, "unit tidak terambil"
		end
		fresh = true
	end

	local ckey, cid = cm:GetAttribute("BrainrotKey"), cm:GetAttribute("BrainrotId")
	if type(ckey) ~= "string" then ckey = carryAttr() or "?" end
	local intended = mA and mA:GetAttribute("BrainrotKey")
	if fresh and intended and ckey ~= intended then
		wrong = wrong + 1
		say(("  salah ambil: %s (id=%s), niat %s"):format(short(ckey), tostring(cid), short(intended)))
	end

	-- cek target yang valid; beri jeda karena CanMerge bisa telat sesaat setelah terambil
	local tgt, anySame = nearestSame(cm, ckey, cid, nil)
	local tw = os.clock()
	local grace = (fresh and intended and ckey ~= intended) and 0.5 or 1.2
	while not tgt and os.clock() - tw < grace and alive(my) do
		task.wait(0.15)
		tgt, anySame = nearestSame(cm, ckey, cid, nil)
	end
	if not tgt then
		local why = noTargetReason(cid, anySame)
		say(("  membawa %s: %s, dilepas"):format(short(ckey), why))
		env.AM_SKIP[ckey] = os.clock() + 60
		if why ~= "tanpa pasangan" then env.AM_IDSKIP[cid] = os.clock() + 90 end
		if not dropAndLeave(my) then return false, "unit terbawa tidak bisa dilepas", true end
		return false, why, false, true
	end

	local hadRec = getRec(ckey) ~= nil
	L(v, ("  terambil: %s (id=%s)"):format(short(ckey), tostring(cid)))

	local runner = (mode == "full") and fullMerge or goMerge
	local reached, tkeys, touches, why = runner(cm, ckey, cid, my, v)
	if #touches > 0 then L(v or not reached, "  menyentuh: " .. table.concat(touches, ", ")) end
	if reached then
		say(("  MERGE OK %s [%s] %.1fs"):format(short(ckey), MODENAME[mode], os.clock() - t00))
	else
		if mode == "full" and why == "server menolak MergePlot" then
			fullFail = fullFail + 1
			if fullFail >= 3 then
				say("FULL ditolak server 3x (MergePlot tanpa dekat), turun ke mode TELE")
				setMode("tele")
			end
		end
		if why == "dibatalkan" then return false, why end
		say(("  merge tidak terjadi (%s)"):format(tostring(why)))
		env.AM_SKIP[ckey] = os.clock() + 60
		local blocked = type(why) == "string" and (why == "level tertinggi" or why:find("diblokir") ~= nil)
		if blocked then env.AM_IDSKIP[cid] = os.clock() + 90 end
		if carryAttr() then
			if not dropAndLeave(my) then return false, "unit terbawa tidak bisa dilepas", true end
		end
		local soft = blocked or why == "tanpa pasangan"
		return false, why, false, soft
	end

	env.AM_SKIP[ckey] = os.clock() + 3
	for k in pairs(tkeys) do env.AM_SKIP[k] = os.clock() + 3 end

	if sync then
		local t0, okv, n = os.clock(), false, -1
		while os.clock() - t0 < 8 do
			n = unitCount()
			if (hadRec and getRec(ckey) == nil) or (n ~= -1 and before ~= -1 and n < before) then
				okv = true
				break
			end
			task.wait(0.25)
		end
		L(true, ("  verifikasi: %s (t+%.1fs, unit %s -> %s)"):format(okv and "OK" or "BELUM", os.clock() - t0, tostring(before), tostring(n)))
		if okv then total = total + 1 end
		return okv, okv and nil or "belum terverifikasi"
	end
	queueVerify({ ckey = ckey, hadRec = hadRec, before = before, t0 = os.clock() })
	return true
end

-- ===== pilih unit A: level terendah dulu, lalu terdekat =====
local function nextCandidate()
	local ps = getPairs()
	local _, byKey = plotModels()
	local ranks, how = getRanks(byKey)
	local r = hrpOf()
	local best, bs, bestRank
	local now = os.clock()
	for _, pr in ipairs(ps) do
		for _, k in ipairs(pr) do
			local m = byKey[k]
			if m and (env.AM_SKIP[k] or 0) < now then
				local id = m:GetAttribute("BrainrotId")
				if (env.AM_IDSKIP[id] or 0) < now and getRec(k) then
					local rk = ranks[id] or 0
					local d = r and (m:GetPivot().Position - r.Position).Magnitude or 0
					local score = rk * 100000 + d
					if not bs or score < bs then best, bs, bestRank = m, score, rk end
				end
			end
		end
	end
	return best, #ps, ranks, how, bestRank
end

