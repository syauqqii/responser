-- InvokeServer dengan batas waktu (satu-satunya yang bisa menggantung)
local function invoke(timeout, ...)
	local args, res, done = table.pack(...), nil, false
	task.spawn(function()
		res = table.pack(pcall(function() return RF:InvokeServer(table.unpack(args, 1, args.n)) end))
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < timeout do task.wait(0.03) end
	if not done then return false, "TIMEOUT" end
	return table.unpack(res, 1, res.n)
end

local function short(k)
	k = tostring(k)
	return (k:match("^%a+") or "?") .. ":" .. k:sub(-4)
end
local function hrpOf() local c = LP.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function humOf() local c = LP.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function frontPos()
	local c = LP.Character
	if not c then return nil end
	local a = c:FindFirstChild("BodyFrontAttachment", true)
	if a and a:IsA("Attachment") then return a.WorldPosition end
	local h = hrpOf()
	return h and h.Position
end
local function xz(a, b) return math.sqrt((a.X - b.X) ^ 2 + (a.Z - b.Z) ^ 2) end

