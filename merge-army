-- watchdog: karakter hampir tidak bergerak 6 detik -> batalkan siklus, lanjut yang lain
local function startWatchdog(my)
	task.spawn(function()
		local lastPos, lastMove = nil, os.clock()
		while env.AM_ON and alive(my) do
			task.wait(0.5)
			local h = hrpOf()
			if h and (not lastPos or (h.Position - lastPos).Magnitude > 1.5) then
				lastPos, lastMove = h.Position, os.clock()
			end
			if step:find("^menunggu") or step:find("^DropOff") or step:find("^ke titik") or step:find("^FULL") then
				lastMove = os.clock()
			end
			if os.clock() - lastMove > 6 then
				say(('WATCHDOG: macet di "%s", siklus dibatalkan'):format(step))
				abortCycle = true
				lastMove = os.clock()
			end
		end
	end)
end

local function setOn(on)
	token = token + 1
	local my = token
	env.AM_ON = on
	abortCycle = false
	setBtn(on)
	say(on and "== ON ==" or "== OFF ==")
	if not on then
		busy = false
		stopWalking()
		return
	end
	busy = true
	local h0 = hrpOf()
	homePos = h0 and h0.Position or nil
	startWatchdog(my)
	task.spawn(function()
		local fails, lastRank, stopMsg = 0, nil, nil
		while env.AM_ON and alive(my) do
			abortCycle = false
			setStep("cari unit")
			local cand, n, _, _, rk = nextCandidate()
			if not cand and not carryAttr() then
				setStep("menunggu pasangan (pairs=" .. n .. ")")
				task.wait(0.1)
			else
				if rk and rk ~= lastRank then
					lastRank = rk
					say("level dikerjakan: " .. tostring(rk))
				end
				local tc = os.clock()
				local ok, why, fatal, soft = cycle(cand, my, false, false)
				mv(("  = siklus %s%s %.1fs [%s]"):format(ok and "OK" or "GAGAL", why and (": " .. tostring(why)) or "", os.clock() - tc, MODENAME[mode]))
				if not alive(my) then break end
				if ok then
					fails = 0
				elseif abortCycle or why == "dibatalkan" or soft then
					abortCycle = false
					if cand then env.AM_SKIP[cand:GetAttribute("BrainrotKey")] = os.clock() + 10 end
				else
					fails = fails + 1
					if cand then env.AM_SKIP[cand:GetAttribute("BrainrotKey")] = os.clock() + 15 end
					say("gagal: " .. tostring(why))
					if fatal then
						say("STOP: ada unit terbawa yang tidak bisa dilepas. Lepas manual, lalu ON lagi.")
						stopMsg = "berhenti: unit terbawa nyangkut"
						break
					end
					if fails >= 6 then
						say("gagal 6x berturut, stop")
						stopMsg = "berhenti: gagal berulang"
						break
					end
				end
				task.wait()
			end
		end
		if alive(my) then
			env.AM_ON = false
			busy = false
			setBtn(false)
			setStep("selesai")
			status.Text = stopMsg or "selesai"
		end
	end)
end
toggle.Activated:Connect(function() setOn(not env.AM_ON) end)



for m, b in pairs(modeBtns) do
	b.Activated:Connect(function() setMode(m) end)
end

local function halt()
	token = token + 1
	env.AM_ON = false
	busy = false
	abortCycle = false
	stopWalking()
	setBtn(false)
end

local function setOpacity(d)
	OPACITY = math.clamp(math.floor((OPACITY + d) * 100 + 0.5) / 100, 0.1, 1)
	opVal.Text = math.floor(OPACITY * 100 + 0.5) .. "%"
	applyOpacity()
end
