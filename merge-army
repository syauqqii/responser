		setStep(("tele ke %s #%d"):format(short(key), try + 1))
		local sp, pen = standPoint(pos, math.max(tr + 1.2, 3.5), m, nil, try)
		teleportTo(sp, pos, ("ambil %s (id=%s) pen=%d"):format(short(key), tostring(m:GetAttribute("BrainrotId")), pen or 0))
		walkTo(pos, 0.8, 2.5, got, my, "unit " .. short(key))
	end
	for _ = 1, 8 do
		if carried() then break end
		task.wait(0.1)
	end
	return carried()
end

