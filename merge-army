-- InvokeServer dengan batas waktu (satu-satunya yang bisa menggantung)
local function invoke(timeout, ...)
	local args, res, done = table.pack(...), nil, false
	task.spawn(function()
		res = table.pack(pcall(function() return RF:InvokeServer(table.unpack(args, 1, args.n)) end))
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < timeout do task.wait(0.03) end
	if not done then return false, "TIMEOUT" end
	return table.unpack(res, 1, res.n)
end

