local CLEAR = 2.6

local function hitInfo(m)
	local hb = P(function() return BU:GetMergeHitbox(m) end)
	if typeof(hb) == "Instance" and hb:IsA("BasePart") then
		local s = hb.Size
		return hb.Position, math.max(s.X, s.Z) / 2
	end
	return m:GetPivot().Position, radiusOf(m)
end

local function obstaclesFor(except, except2)
	local res = {}
	for _, m in ipairs((plotModels())) do
		if m ~= except and m ~= except2 then
			local pos, r = hitInfo(m)
			res[#res + 1] = { p = Vector3.new(pos.X, 0, pos.Z), r = r + CLEAR }
		end
	end
	return res
end

local function segHit(a, b, o)
	local ab = b - a
	local len2 = ab.X * ab.X + ab.Z * ab.Z
	if len2 < 1e-6 then return 0, (a - o.p).Magnitude end
	local t = ((o.p.X - a.X) * ab.X + (o.p.Z - a.Z) * ab.Z) / len2
	t = math.clamp(t, 0, 1)
	local c = a + ab * t
	return t, Vector3.new(c.X - o.p.X, 0, c.Z - o.p.Z).Magnitude
end

local function planPath(from, to, obs)
	from = Vector3.new(from.X, 0, from.Z)
	to = Vector3.new(to.X, 0, to.Z)
	local active = {}
	for _, o in ipairs(obs) do
		if (o.p - from).Magnitude > o.r and (o.p - to).Magnitude > o.r then
			active[#active + 1] = o
		end
	end
	local pts = { from, to }
	for _ = 1, 24 do
		local fixed = true
		for i = 1, #pts - 1 do
			local a, b = pts[i], pts[i + 1]
			local worst, wt
			for _, o in ipairs(active) do
				local t, d = segHit(a, b, o)
				if d < o.r - 0.05 and (not wt or t < wt) then worst, wt = o, t end
			end
			if worst then
				local dir = b - a
				dir = dir.Magnitude > 0 and dir.Unit or Vector3.new(0, 0, 1)
				local perp = Vector3.new(-dir.Z, 0, dir.X)
				local off = worst.r * 1.25 + 0.6
				local c1, c2 = worst.p + perp * off, worst.p - perp * off
				local function cost(c)
					local pen = 0
					for _, o in ipairs(active) do
						if o ~= worst and (o.p - c).Magnitude < o.r then pen = pen + 100 end
					end
					return (c - a).Magnitude + (b - c).Magnitude + pen
				end
				table.insert(pts, i + 1, cost(c1) <= cost(c2) and c1 or c2)
				fixed = false
				break
			end
		end
		if fixed then break end
	end
	table.remove(pts, 1)
	return pts
end

local function walkPath(pts, timeoutPer, abort, my, tag)
	for i, p in ipairs(pts) do
		walkTo(p, (i == #pts) and 0.8 or 1.2, timeoutPer, abort, my, ("%s %d/%d"):format(tag or "jalur", i, #pts))
		if abort and abort() then return true end
		if not live(my) then return false end
	end
	return true
end

-- 1) jalan ke unit A (menghindari unit lain) sampai terambil oleh game
local function pickUp(m, my, v)
	local key = m:GetAttribute("BrainrotKey")
	local pos = m:GetPivot().Position
	setStep("jalan ke " .. short(key))
	L(v, ("ambil %s (id=%s) | pos=(%.0f,%.0f,%.0f)"):format(short(key), tostring(m:GetAttribute("BrainrotId")), pos.X, pos.Y, pos.Z))
	local function got() return carryAttr() ~= nil end
	local function approach()
		local r = hrpOf()
		if not r then return end
		local pts = planPath(r.Position, pos, obstaclesFor(m))
		L(v, ("  jalur: %d titik"):format(#pts))
		walkPath(pts, 10, got, my, "unit " .. short(key))
	end
	approach()
	local tries = 0
	while not got() and tries < 3 and live(my) do
		tries = tries + 1
		mv("  belum terambil, mundur lalu masuk lagi " .. tries)
		local r = hrpOf()
		if r then
			local dir = Vector3.new(r.Position.X - pos.X, 0, r.Position.Z - pos.Z)
			dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
			walkTo(pos + dir * 4, 1.2, 2, got, my, "mundur")
		end
		approach()
		task.wait(0.05)
	end
	for _ = 1, 10 do
		if carried() then break end
		task.wait(0.1)
	end
	return carried()
end

-- titik berdiri di sekitar target yang tidak menyentuh hitbox unit lain
local OFFS = { 0, 45, -45, 90, -90, 135, -135, 180 }
local function standPoint(tpos, dist, ex1, ex2, variant)
	local r = hrpOf()
	local base = r and Vector3.new(r.Position.X - tpos.X, 0, r.Position.Z - tpos.Z) or Vector3.new(0, 0, 1)
	base = base.Magnitude > 0.1 and base.Unit or Vector3.new(0, 0, 1)
	local obs = {}
	for _, m in ipairs((plotModels())) do
		if m ~= ex1 and m ~= ex2 then
			local p, rr = hitInfo(m)
			obs[#obs + 1] = { p = Vector3.new(p.X, 0, p.Z), r = rr + 0.8 }
		end
	end
	local t3 = Vector3.new(tpos.X, 0, tpos.Z)
	local best, bestPen
	for i = 0, 7 do
		local ang = math.rad(OFFS[((variant or 0) * 2 + i) % 8 + 1])
		local cs, sn = math.cos(ang), math.sin(ang)
		local dir = Vector3.new(base.X * cs - base.Z * sn, 0, base.X * sn + base.Z * cs)
		local c = t3 + dir * dist
		local pen = 0
		for _, o in ipairs(obs) do
			if (o.p - c).Magnitude < o.r then pen = pen + 100 end
			local _, dd = segHit(c, t3, o)
			if dd < o.r and (o.p - t3).Magnitude > o.r then pen = pen + 10 end
		end
		if not bestPen or pen < bestPen then best, bestPen = c, pen end
		if pen == 0 then break end
	end
	return Vector3.new(best.X, r and r.Position.Y or tpos.Y, best.Z), bestPen
end

-- MODE TELE: teleport ke sebelah unit A, jalan kaki sedikit sampai terambil
local function telePickup(m, my, v)
	local key = m:GetAttribute("BrainrotKey")
