local OPACITY = 0.10

local bgList = {}
local function collect()
	bgList = {}
	local function add(o)
		local isText = o:IsA("TextButton") or o:IsA("TextLabel") or o:IsA("TextBox")
		if (o:IsA("Frame") or o:IsA("ScrollingFrame") or isText) and o.BackgroundTransparency < 1 then
			bgList[#bgList + 1] = o
		end
		if isText then
			o.TextStrokeTransparency = 0.5
			o.TextStrokeColor3 = Color3.new(0, 0, 0)
		end
	end
	add(win)
	for _, d in ipairs(win:GetDescendants()) do add(d) end
end

local function applyOpacity()
	local tr = 1 - OPACITY
	for _, o in ipairs(bgList) do
		if o.Parent then o.BackgroundTransparency = tr end
	end
	scroll.ScrollBarImageTransparency = 0.3
end

