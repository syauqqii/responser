-- ===== urutan level (rendah dulu), di-cache =====
local function computeRanks(byKey)
	local ids, health = {}, {}
	for _, m in pairs(byKey) do
		local id = m:GetAttribute("BrainrotId")
		if type(id) == "string" then
			ids[id] = true
			health[id] = tonumber(m:GetAttribute("Health")) or 0
		end
	end
	local ranks, how = {}, "Health (perkiraan)"
	if UM then
		local known, preds, queue = {}, {}, {}
		for id in pairs(ids) do known[id] = true end
		for l = 1, 80 do
			local i = P(function() return UM:GetIdForSpawnLevel(l) end)
			if type(i) == "string" then known[i] = true end
		end
		for id in pairs(known) do queue[#queue + 1] = id end
		local n = 1
		while queue[n] and n < 400 do
			local id = queue[n]
			n = n + 1
			local nx = P(function() return UM:GetNextId(id) end)
			if type(nx) == "string" and nx ~= id then
				preds[nx] = preds[nx] or {}
				table.insert(preds[nx], id)
				if not known[nx] then
					known[nx] = true
					queue[#queue + 1] = nx
				end
			end
		end
		local memo = {}
		local function depth(id, seen)
			if memo[id] then return memo[id] end
			if seen[id] then return 0 end
			seen[id] = true
			local best = 0
			for _, p in ipairs(preds[id] or {}) do
				best = math.max(best, depth(p, seen) + 1)
			end
			seen[id] = nil
			memo[id] = best
			return best
		end
		for id in pairs(ids) do ranks[id] = depth(id, {}) end
		how = "rantai GetNextId"
	else
		for id in pairs(ids) do ranks[id] = health[id] end
	end
	return ranks, how
end

local rkCache = { sig = "", ranks = {}, how = "" }
local function getRanks(byKey)
	local set, ids = {}, {}
	for _, m in pairs(byKey) do
		local id = m:GetAttribute("BrainrotId")
		if type(id) == "string" and not set[id] then
			set[id] = true
			ids[#ids + 1] = id
		end
	end
	table.sort(ids)
	local sig = table.concat(ids, ",")
	if sig ~= rkCache.sig then
		local r, how = computeRanks(byKey)
		rkCache = { sig = sig, ranks = r, how = how }
	end
	return rkCache.ranks, rkCache.how
end

local function rankText(ranks)
	local arr = {}
	for id, r in pairs(ranks) do arr[#arr + 1] = { id, r } end
	table.sort(arr, function(a, b) return a[2] < b[2] end)
	local t = {}
	for _, e in ipairs(arr) do t[#t + 1] = ("%s(%s)"):format(e[1], tostring(e[2])) end
	return table.concat(t, " < ")
end

-- ===== jalan kaki =====
local function walkTo(pos, stopDist, timeout, abort, my, tag)
	local t0 = os.clock()
	local lastP, lastT
	tag = tag or "titik"
	goal = { name = tag, pos = pos }
	local r0 = hrpOf()
	mv(("  JALAN %s -> %s jarak=%.1f"):format(tag, fmt(pos), r0 and xz(r0.Position, pos) or -1))
	local function fin(res, why)
		local r = hrpOf()
		mv(("  JALAN selesai: %s %.1fs sisa=%.1f"):format(why, os.clock() - t0, r and xz(r.Position, pos) or -1))
		return res
	end
	while os.clock() - t0 < timeout do
		if not live(my) then return fin(false, "dibatalkan") end
		if abort and abort() then return fin(true, "kondisi tercapai") end
		local h, r = humOf(), hrpOf()
		if not (h and r and h.Health > 0) then return fin(false, "karakter hilang") end
		local flat = Vector3.new(pos.X - r.Position.X, 0, pos.Z - r.Position.Z).Magnitude
		if flat <= stopDist then return fin(true, "sampai") end
		h:MoveTo(Vector3.new(pos.X, r.Position.Y, pos.Z))
		if not lastP or (r.Position - lastP).Magnitude > 0.8 then
			lastP, lastT = r.Position, os.clock()
		elseif os.clock() - lastT > 1.2 then
			h.Jump = true
			lastT = os.clock()
			mv("    lompat (tersangkut)")
		end
		task.wait(0.1)
	end
	return fin(false, "timeout")
end

-- teleport karakter (hadap ke lookAt), lalu sisanya jalan kaki
local function teleportTo(pos, lookAt, why)
	local r = hrpOf()
	if not r then return false end
	local from = r.Position
	local p = Vector3.new(pos.X, from.Y, pos.Z)
	local look = Vector3.new(lookAt.X, p.Y, lookAt.Z)
	if (look - p).Magnitude < 0.1 then look = p + r.CFrame.LookVector end
	r.CFrame = CFrame.lookAt(p, look)
	P(function() r.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
	goal = { name = "tele", pos = p }
	mv(("  TELE %s: %s -> %s (%.1f stud) hadap %s"):format(why, fmt(from), fmt(p), (from - p).Magnitude, fmt(lookAt)))
	task.wait(0.05)
	return true
end

