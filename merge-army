-- unit milik plot kita; hasil "bukan milik" hanya di-cache sebentar
local mine = setmetatable({}, { __mode = "k" })
local mineNo = setmetatable({}, { __mode = "k" })
local function isMine(m)
	if mine[m] then return true end
	local t = mineNo[m]
	if t and os.clock() - t < 1.5 then return false end
	local ok = P(function() return BU:IsPlotUnitOnPlayerPlot(LP, m) end) == true
	if ok then
		mine[m] = true
		mineNo[m] = nil
	else
		mineNo[m] = os.clock()
	end
	return ok
end

local pmC, pmT
local function plotModels()
	if pmC and os.clock() - pmT < 0.3 then return pmC.list, pmC.byKey end
	local list, byKey = {}, {}
	for _, m in ipairs(CS:GetTagged("PlotBrainrot")) do
		if m:IsA("Model") and m.Parent
			and not m:GetAttribute("PlotEffectClone") and not m:GetAttribute("MergeEffectClone") then
			local k = m:GetAttribute("BrainrotKey")
			if typeof(k) == "string" and isMine(m) then
				list[#list + 1] = m
				byKey[k] = m
			end
		end
	end
	pmC, pmT = { list = list, byKey = byKey }, os.clock()
	return list, byKey
end
local function unitOf(inst)
	local p = inst
	while p and p ~= workspace do
		if p:IsA("Model") and CS:HasTag(p, "PlotBrainrot") then return p end
		p = p.Parent
	end
end

