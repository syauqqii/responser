-- CanMergePlotUnits (dipakai game sendiri saat unit dibawa), di-cache sebentar
local cmCache, cmN = {}, 0
local function canMergeKeys(a, b)
	local key = tostring(a) .. "|" .. tostring(b)
	local c = cmCache[key]
	if c and os.clock() - c.t < 0.6 then return c.v end
	local v = P(function() return BU:CanMergePlotUnits(LP, a, b) end) == true
	cmN = cmN + 1
	if cmN > 400 then
		cmCache, cmN = {}, 0
	end
	cmCache[key] = { t = os.clock(), v = v }
	return v
end

-- ===== urutan level (rendah dulu), di-cache =====
local function computeRanks(byKey)
	local ids, health = {}, {}
	for _, m in pairs(byKey) do
		local id = m:GetAttribute("BrainrotId")
		if type(id) == "string" then
			ids[id] = true
			health[id] = tonumber(m:GetAttribute("Health")) or 0
		end
	end
	local ranks, how = {}, "Health (perkiraan)"
	if UM then
		local known, preds, queue = {}, {}, {}
		for id in pairs(ids) do known[id] = true end
		for l = 1, 80 do
			local i = P(function() return UM:GetIdForSpawnLevel(l) end)
			if type(i) == "string" then known[i] = true end
		end
		for id in pairs(known) do queue[#queue + 1] = id end
		local n = 1
		while queue[n] and n < 400 do
			local id = queue[n]
			n = n + 1
			local nx = P(function() return UM:GetNextId(id) end)
			if type(nx) == "string" and nx ~= id then
				preds[nx] = preds[nx] or {}
				table.insert(preds[nx], id)
				if not known[nx] then
					known[nx] = true
					queue[#queue + 1] = nx
				end
			end
		end
		local memo = {}
		local function depth(id, seen)
			if memo[id] then return memo[id] end
			if seen[id] then return 0 end
			seen[id] = true
			local best = 0
			for _, p in ipairs(preds[id] or {}) do
				best = math.max(best, depth(p, seen) + 1)
			end
			seen[id] = nil
			memo[id] = best
			return best
		end
		for id in pairs(ids) do ranks[id] = depth(id, {}) end
		how = "rantai GetNextId"
	else
		for id in pairs(ids) do ranks[id] = health[id] end
	end
	return ranks, how
end

local rkCache = { sig = "", ranks = {}, how = "" }
local function getRanks(byKey)
	local set, ids = {}, {}
	for _, m in pairs(byKey) do
		local id = m:GetAttribute("BrainrotId")
		if type(id) == "string" and not set[id] then
			set[id] = true
			ids[#ids + 1] = id
		end
	end
	table.sort(ids)
	local sig = table.concat(ids, ",")
	if sig ~= rkCache.sig then
		local r, how = computeRanks(byKey)
		rkCache = { sig = sig, ranks = r, how = how }
	end
	return rkCache.ranks, rkCache.how
end

local function rankText(ranks)
	local arr = {}
	for id, r in pairs(ranks) do arr[#arr + 1] = { id, r } end
	table.sort(arr, function(a, b) return a[2] < b[2] end)
	local t = {}
	for _, e in ipairs(arr) do t[#t + 1] = ("%s(%s)"):format(e[1], tostring(e[2])) end
	return table.concat(t, " < ")
end

-- ===== jalan kaki =====
local function walkTo(pos, stopDist, timeout, abort, my)
	local t0 = os.clock()
	local lastP, lastT
	while os.clock() - t0 < timeout do
		if not live(my) then return false end
		if abort and abort() then return true end
		local h, r = humOf(), hrpOf()
		if not (h and r and h.Health > 0) then return false end
		local flat = Vector3.new(pos.X - r.Position.X, 0, pos.Z - r.Position.Z).Magnitude
		if flat <= stopDist then return true end
		h:MoveTo(Vector3.new(pos.X, r.Position.Y, pos.Z))
		if not lastP or (r.Position - lastP).Magnitude > 0.8 then
			lastP, lastT = r.Position, os.clock()
		elseif os.clock() - lastT > 1.2 then
			h.Jump = true
			lastT = os.clock()
		end
		task.wait(0.1)
	end
	return false
end

-- ===== jalur yang menghindari unit lain =====
local CLEAR = 2.0

local function hitInfo(m)
	local hb = P(function() return BU:GetMergeHitbox(m) end)
	if typeof(hb) == "Instance" and hb:IsA("BasePart") then
		local s = hb.Size
		return hb.Position, math.max(s.X, s.Z) / 2
	end
	return m:GetPivot().Position, radiusOf(m)
end

local function obstaclesFor(except)
	local res = {}
	for _, m in ipairs((plotModels())) do
		if m ~= except then
			local pos, r = hitInfo(m)
			res[#res + 1] = { p = Vector3.new(pos.X, 0, pos.Z), r = r + CLEAR }
		end
	end
	return res
end

local function segHit(a, b, o)
	local ab = b - a
	local len2 = ab.X * ab.X + ab.Z * ab.Z
	if len2 < 1e-6 then return 0, (a - o.p).Magnitude end
	local t = ((o.p.X - a.X) * ab.X + (o.p.Z - a.Z) * ab.Z) / len2
	t = math.clamp(t, 0, 1)
	local c = a + ab * t
	return t, Vector3.new(c.X - o.p.X, 0, c.Z - o.p.Z).Magnitude
end

local function planPath(from, to, obs)
	from = Vector3.new(from.X, 0, from.Z)
	to = Vector3.new(to.X, 0, to.Z)
	local active = {}
	for _, o in ipairs(obs) do
		if (o.p - from).Magnitude > o.r and (o.p - to).Magnitude > o.r then
			active[#active + 1] = o
		end
	end
	local pts = { from, to }
	for _ = 1, 24 do
		local fixed = true
		for i = 1, #pts - 1 do
			local a, b = pts[i], pts[i + 1]
			local worst, wt
			for _, o in ipairs(active) do
				local t, d = segHit(a, b, o)
				if d < o.r - 0.05 and (not wt or t < wt) then worst, wt = o, t end
			end
			if worst then
				local dir = b - a
				dir = dir.Magnitude > 0 and dir.Unit or Vector3.new(0, 0, 1)
				local perp = Vector3.new(-dir.Z, 0, dir.X)
				local off = worst.r * 1.25 + 0.6
				local c1, c2 = worst.p + perp * off, worst.p - perp * off
				local function cost(c)
					local pen = 0
					for _, o in ipairs(active) do
						if o ~= worst and (o.p - c).Magnitude < o.r then pen = pen + 100 end
					end
					return (c - a).Magnitude + (b - c).Magnitude + pen
				end
				table.insert(pts, i + 1, cost(c1) <= cost(c2) and c1 or c2)
				fixed = false
				break
			end
		end
		if fixed then break end
	end
	table.remove(pts, 1)
	return pts
end

local function walkPath(pts, timeoutPer, abort, my)
	for i, p in ipairs(pts) do
		walkTo(p, (i == #pts) and 0.8 or 1.2, timeoutPer, abort, my)
		if abort and abort() then return true end
		if not live(my) then return false end
	end
	return true
end

-- 1) jalan ke unit A (menghindari unit lain) sampai terambil oleh game
local function pickUp(m, my, v)
	local key = m:GetAttribute("BrainrotKey")
	local pos = m:GetPivot().Position
	setStep("jalan ke " .. short(key))
	L(v, ("ambil %s (id=%s) | pos=(%.0f,%.0f,%.0f)"):format(short(key), tostring(m:GetAttribute("BrainrotId")), pos.X, pos.Y, pos.Z))
	local function got() return carryAttr() ~= nil end
	local function approach()
		local r = hrpOf()
		if not r then return end
		local pts = planPath(r.Position, pos, obstaclesFor(m))
		L(v, ("  jalur: %d titik"):format(#pts))
		walkPath(pts, 10, got, my)
	end
	approach()
	local tries = 0
	while not got() and tries < 3 and live(my) do
		tries = tries + 1
		L(v, "  belum terambil, mundur lalu masuk lagi " .. tries)
		local r = hrpOf()
		if r then
			local dir = Vector3.new(r.Position.X - pos.X, 0, r.Position.Z - pos.Z)
			dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
			walkTo(pos + dir * 4, 1.2, 3, got, my)
		end
		approach()
		task.wait(0.1)
	end
	for _ = 1, 10 do
		if carried() then break end
		task.wait(0.1)
	end
	return carried()
end

-- 2) target = unit sejenis yang benar-benar bisa di-merge (CanMerge=true), terdekat
local function nearestSame(cm, ckey, cid, cur)
	if not canPair(cid) then return nil, true end
	local list = plotModels()
	local f = frontPos()
	local best, bd, anySame
	for _, m in ipairs(list) do
		local k = m:GetAttribute("BrainrotKey")
		if m ~= cm and k ~= ckey and m:GetAttribute("BrainrotId") == cid then
			anySame = true
			if canMergeKeys(ckey, k) then
				local d = f and xz(f, probeOf(m)) or 0
				if not bd or d < bd then best, bd = m, d end
			end
		end
	end
	if cur and cur.Parent and best and cur ~= best and f then
		local ck = cur:GetAttribute("BrainrotKey")
		if canMergeKeys(ckey, ck) and xz(f, probeOf(cur)) <= bd + 4 then return cur, anySame end
	end
	return best, anySame
end

local function noTargetReason(cid, anySame)
	if not canPair(cid) then return "level tertinggi" end
	if anySame then return "diblokir (rebirth/terkunci)" end
	return "tanpa pasangan"
end

-- 3) jalan ke target; merge dengan unit sejenis mana pun yang tersentuh sah
local function goMerge(cm, ckey, cid, my, v)
	local tkeys, touches, conns = {}, {}, {}
	for _, part in ipairs(cm:GetDescendants()) do
		if part:IsA("BasePart") then
			conns[#conns + 1] = part.Touched:Connect(function(o)
				local u = unitOf(o)
				if u and u ~= cm then
					local k = u:GetAttribute("BrainrotKey")
					if typeof(k) == "string" and not tkeys[k] then
						tkeys[k] = true
						touches[#touches + 1] = ("%s(%s)"):format(short(k), tostring(u:GetAttribute("BrainrotId")))
					end
				end
			end)
		end
	end
	local function finish(ok, why)
		for _, c in ipairs(conns) do c:Disconnect() end
		return ok, tkeys, touches, why
	end

	local target, noTargetSince
	local t0, lastPick = os.clock(), 0
	local inRangeSince, turns = nil, 0
	setStep("cari target sejenis")
	while os.clock() - t0 < 20 do
		if not live(my) then return finish(false, "dibatalkan") end
		if carryAttr() == nil then return finish(true) end
		if os.clock() - lastPick > 0.5 then
			lastPick = os.clock()
			local nt, anySame = nearestSame(cm, ckey, cid, target)
			if nt ~= target then
				target = nt
				if target then
					L(v, ("  target %s"):format(short(target:GetAttribute("BrainrotKey"))))
					setStep("jalan ke target " .. short(target:GetAttribute("BrainrotKey")))
				end
			end
			if not target then
				noTargetSince = noTargetSince or os.clock()
				if os.clock() - noTargetSince > 1.2 then
					return finish(false, noTargetReason(cid, anySame))
				end
			else
				noTargetSince = nil
			end
		end
		if target then
			local pr = probeOf(target)
			local f = frontPos()
			local d = f and xz(f, pr) or 99
			local R = radiusOf(cm) + radiusOf(target)
			local h = humOf()
			if not h then return finish(false, "tidak ada humanoid") end
			local hr = hrpOf()
			local y = hr and hr.Position.Y or pr.Y
			if d <= R then
				inRangeSince = inRangeSince or os.clock()
				if os.clock() - inRangeSince > 1.2 then
					turns = turns + 1
					local tk = target:GetAttribute("BrainrotKey")
					say(("  dekat tapi belum merge (d=%.1f R=%.1f canMerge=%s), mundur lalu masuk lagi #%d"):format(
						d, R, tostring(canMergeKeys(ckey, tk)), turns))
					if turns >= 5 then return finish(false, "sentuhan tidak memicu merge") end
					local dir = f and Vector3.new(f.X - pr.X, 0, f.Z - pr.Z) or Vector3.new(0, 0, 1)
					dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
					local ang = ((turns % 2 == 1) and 1 or -1) * math.rad(35 * math.ceil(turns / 2))
					local cs, sn = math.cos(ang), math.sin(ang)
					local rot = Vector3.new(dir.X * cs - dir.Z * sn, 0, dir.X * sn + dir.Z * cs)
					walkTo(pr + rot * (R + 4), 1, 3, function() return carryAttr() == nil end, my)
					inRangeSince = nil
				else
					h:MoveTo(Vector3.new(pr.X, y, pr.Z))
				end
			else
				inRangeSince = nil
				h:MoveTo(Vector3.new(pr.X, y, pr.Z))
			end
		end
		task.wait(0.1)
	end
	return finish(carryAttr() == nil, "timeout 20 detik")
end

-- ===== lepas unit =====
local homePos

local function dropAndLeave(my)
	setStep("DropOff")
	if carryAttr() == nil then
		if carriedRaw() then
			say("  sisa visual unit, dibersihkan")
			cleanStale()
		end
		return true
	end
	for attempt = 1, 4 do
		local okd, rd = invoke(6, "DropOff")
		local t0 = os.clock()
		while os.clock() - t0 < 1.5 and carryAttr() do task.wait(0.1) end
		local a = carryAttr()
		say(("  DropOff #%d ok=%s r=%s | attr=%s model=%s"):format(
			attempt, tostring(okd), tostring(rd), a and short(a) or "nil", carriedRaw() and "ada" or "nil"))
		if not a then
			drops = drops + 1
			if carriedRaw() then
				say("  sisa visual unit, dibersihkan")
				cleanStale()
			end
			local h = hrpOf()
			if h then walkTo(h.Position - h.CFrame.LookVector * 6, 1.5, 3, nil, my) end
			return true
		end
		if attempt == 2 and homePos then
			setStep("ke titik awal")
			walkTo(homePos, 3, 6, nil, my)
			setStep("DropOff")
		end
		task.wait(1.0)
		if not alive(my) then return false end
	end
	say("  unit MASIH terbawa setelah 4x DropOff")
	return false
end

-- ===== verifikasi merge: satu pekerja untuk semua =====
local vq, vrun = {}, false
local function queueVerify(item)
	vq[#vq + 1] = item
	if vrun then return end
	vrun = true
	task.spawn(function()
		while #vq > 0 and env.AM_GEN == gen do
			local now, n = os.clock(), unitCount()
			for i = #vq, 1, -1 do
				local it = vq[i]
				local gone = it.hadRec and getRec(it.ckey) == nil
				if gone or (n ~= -1 and it.before ~= -1 and n < it.before) then
					total = total + 1
					table.remove(vq, i)
				elseif now - it.t0 > 8 then
					say(("perhatian: %s belum terverifikasi (unit %s -> %s)"):format(short(it.ckey), tostring(it.before), tostring(n)))
					table.remove(vq, i)
				end
			end
			task.wait(0.5)
		end
		vrun = false
	end)
end

-- ===== satu siklus. return: ok, alasan, fatal, soft =====
local function cycle(mA, my, v, sync)
	local before = unitCount()
	if carryAttr() == nil and carriedRaw() then
		say("  ada sisa visual unit, dibersihkan")
		cleanStale()
		task.wait(0.3)
	end
	local cm = carried()
	if not cm and carryAttr() then
		say("  server mencatat ada unit terbawa tapi modelnya tidak ada, dilepas")
		if not dropAndLeave(my) then return false, "unit terbawa tidak bisa dilepas", true end
	end
	local fresh = false
	if not cm then
		if not (mA and mA.Parent) then return false, "unit hilang", false, true end
		cm = pickUp(mA, my, v)
		if not cm then return false, "unit tidak terambil" end
		fresh = true
	end

	local ckey, cid = cm:GetAttribute("BrainrotKey"), cm:GetAttribute("BrainrotId")
	if type(ckey) ~= "string" then ckey = carryAttr() or "?" end
	local intended = mA and mA:GetAttribute("BrainrotKey")
	if fresh and intended and ckey ~= intended then
		wrong = wrong + 1
		say(("  salah ambil: %s (id=%s), niat %s"):format(short(ckey), tostring(cid), short(intended)))
	end

	-- cek target yang valid; beri jeda karena CanMerge bisa telat sesaat setelah terambil
	local tgt, anySame = nearestSame(cm, ckey, cid, nil)
	local tw = os.clock()
	while not tgt and os.clock() - tw < 1.2 and alive(my) do
		task.wait(0.15)
		tgt, anySame = nearestSame(cm, ckey, cid, nil)
	end
	if not tgt then
		local why = noTargetReason(cid, anySame)
		say(("  membawa %s: %s, dilepas"):format(short(ckey), why))
		env.AM_SKIP[ckey] = os.clock() + 60
		if why ~= "tanpa pasangan" then env.AM_IDSKIP[cid] = os.clock() + 90 end
		if not dropAndLeave(my) then return false, "unit terbawa tidak bisa dilepas", true end
		return false, why, false, true
	end

	local hadRec = getRec(ckey) ~= nil
	L(v, ("  terambil: %s (id=%s)"):format(short(ckey), tostring(cid)))

	local reached, tkeys, touches, why = goMerge(cm, ckey, cid, my, v)
	if #touches > 0 then L(v or not reached, "  menyentuh: " .. table.concat(touches, ", ")) end
	if not reached then
		if why == "dibatalkan" then return false, why end
		say(("  merge tidak terjadi (%s)"):format(tostring(why)))
		env.AM_SKIP[ckey] = os.clock() + 60
		local blocked = type(why) == "string" and (why == "level tertinggi" or why:find("diblokir") ~= nil)
		if blocked then env.AM_IDSKIP[cid] = os.clock() + 90 end
		if carryAttr() then
			if not dropAndLeave(my) then return false, "unit terbawa tidak bisa dilepas", true end
		end
		local soft = blocked or why == "tanpa pasangan"
		return false, why, false, soft
	end

	env.AM_SKIP[ckey] = os.clock() + 3
	for k in pairs(tkeys) do env.AM_SKIP[k] = os.clock() + 3 end

	if sync then
		local t0, okv, n = os.clock(), false, -1
		while os.clock() - t0 < 8 do
			n = unitCount()
			if (hadRec and getRec(ckey) == nil) or (n ~= -1 and before ~= -1 and n < before) then
				okv = true
				break
			end
			task.wait(0.25)
		end
		L(true, ("  verifikasi: %s (t+%.1fs, unit %s -> %s)"):format(okv and "OK" or "BELUM", os.clock() - t0, tostring(before), tostring(n)))
		if okv then total = total + 1 end
		return okv, okv and nil or "belum terverifikasi"
	end
	queueVerify({ ckey = ckey, hadRec = hadRec, before = before, t0 = os.clock() })
	return true
end

-- ===== pilih unit A: level terendah dulu, lalu terdekat =====
local function nextCandidate()
	local ps = getPairs()
	local _, byKey = plotModels()
	local ranks, how = getRanks(byKey)
	local r = hrpOf()
	local best, bs, bestRank
	local now = os.clock()
	for _, pr in ipairs(ps) do
		for _, k in ipairs(pr) do
			local m = byKey[k]
			if m and (env.AM_SKIP[k] or 0) < now then
				local id = m:GetAttribute("BrainrotId")
				if (env.AM_IDSKIP[id] or 0) < now and getRec(k) then
					local rk = ranks[id] or 0
					local d = r and (m:GetPivot().Position - r.Position).Magnitude or 0
					local score = rk * 100000 + d
					if not bs or score < bs then best, bs, bestRank = m, score, rk end
				end
			end
		end
	end
	return best, #ps, ranks, how, bestRank
end

