#define STRINGS_COUNT (sizeof(STRINGS) / sizeof(STRINGS[0]))

static const char *S(const char *key)
{
    for (size_t i = 0; i < STRINGS_COUNT; i++) {
        if (strcmp(STRINGS[i].key, key) == 0) return STRINGS[i].value;
    }
    return "?";
}

static const char *TAG;

// =========================================================
// KONFIGURASI MULTI-PROFILE
// =========================================================
typedef struct {
    const char *name;
    const char *ssid;
    const char *pass;
} net_config_t;

static const net_config_t NET_CONFIGS[] = {
    { .name = "SHT20-A", .ssid = "...", .pass = "..." },
    { .name = "SHT20-B", .ssid = "...",  .pass = "..." },
};
#define NUM_CONFIGS (sizeof(NET_CONFIGS) / sizeof(NET_CONFIGS[0]))

static net_config_t s_active_cfg;
static char s_api_url[192] = {0};

// =========================================================
// I2C SHT20 / TOMBOL
// =========================================================
#define I2C_MASTER_SDA_IO               33
#define I2C_MASTER_SCL_IO               25
#define I2C_MASTER_FREQ_HZ              100000
#define SHT20_I2C_ADDR                  0x40
#define SHT20_CMD_TRIGGER_TEMP_NOHOLD   0xF3
#define SHT20_CMD_TRIGGER_RH_NOHOLD     0xF5

#define BOOT_BUTTON_GPIO     GPIO_NUM_0
#define DEBOUNCE_US          300000
#define STATUS_LED_GPIO      GPIO_NUM_2

static i2c_master_dev_handle_t sht20_handle;
static EventGroupHandle_t s_wifi_event_group;
#define WIFI_CONNECTED_BIT BIT0

static volatile int64_t s_last_isr_time = 0;
static QueueHandle_t s_button_evt_queue = NULL;

// ---------------------------------------------------------
// NVS
// ---------------------------------------------------------
static uint8_t nvs_get_cfg_idx(void)
{
    nvs_handle_t handle;
    uint8_t idx = 0;
    if (nvs_open("storage", NVS_READONLY, &handle) == ESP_OK) {
        nvs_get_u8(handle, "cfg_idx", &idx);
        nvs_close(handle);
    }
    if (idx >= NUM_CONFIGS) idx = 0;
    return idx;
}

static void nvs_set_cfg_idx(uint8_t idx)
{
    nvs_handle_t handle;
    if (nvs_open("storage", NVS_READWRITE, &handle) == ESP_OK) {
        nvs_set_u8(handle, "cfg_idx", idx);
        nvs_commit(handle);
        nvs_close(handle);
    }
}

static bool nvs_get_api_url_cache(char *out, size_t out_len)
{
    nvs_handle_t handle;
    bool ok = false;
    if (nvs_open("storage", NVS_READONLY, &handle) == ESP_OK) {
        size_t len = out_len;
        if (nvs_get_str(handle, "api_url", out, &len) == ESP_OK) ok = true;
        nvs_close(handle);
    }
    return ok;
}

static void nvs_set_api_url_cache(const char *url)
{
    nvs_handle_t handle;
    if (nvs_open("storage", NVS_READWRITE, &handle) == ESP_OK) {
        nvs_set_str(handle, "api_url", url);
        nvs_commit(handle);
        nvs_close(handle);
    }
}

// ---------------------------------------------------------
// Tombol BOOT -> ganti wifi profile -> restart
// ---------------------------------------------------------
static void IRAM_ATTR boot_button_isr_handler(void *arg)
{
    int64_t now = esp_timer_get_time();
    if (now - s_last_isr_time > DEBOUNCE_US) {
        s_last_isr_time = now;
        uint32_t dummy = 1;
        xQueueSendFromISR(s_button_evt_queue, &dummy, NULL);
    }
}

static void status_led_blink(int times)
{
    for (int i = 0; i < times; i++) {
        gpio_set_level(STATUS_LED_GPIO, 1);
        vTaskDelay(pdMS_TO_TICKS(150));
        gpio_set_level(STATUS_LED_GPIO, 0);
        vTaskDelay(pdMS_TO_TICKS(150));
    }
}

static void button_task(void *arg)
{
    uint32_t dummy;
    while (1) {
        if (xQueueReceive(s_button_evt_queue, &dummy, portMAX_DELAY)) {
            uint8_t idx = nvs_get_cfg_idx();
            idx = (idx + 1) % NUM_CONFIGS;
            nvs_set_cfg_idx(idx);
            ESP_LOGW(TAG, S("info-switch"), NET_CONFIGS[idx].name, idx);
            status_led_blink(idx + 1);
            vTaskDelay(pdMS_TO_TICKS(300));
            esp_restart();
        }
    }
}

static void button_init(void)
{
    gpio_config_t io_conf = {
        .pin_bit_mask = (1ULL << BOOT_BUTTON_GPIO),
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_NEGEDGE,
    };
    gpio_config(&io_conf);

    gpio_config_t led_conf = {
        .pin_bit_mask = (1ULL << STATUS_LED_GPIO),
        .mode = GPIO_MODE_OUTPUT,
    };
    gpio_config(&led_conf);

    s_button_evt_queue = xQueueCreate(5, sizeof(uint32_t));
    gpio_install_isr_service(0);
    gpio_isr_handler_add(BOOT_BUTTON_GPIO, boot_button_isr_handler, NULL);

    xTaskCreate(button_task, "button_task", 4096, NULL, 10, NULL);
}

// ---------------------------------------------------------
// Wi-Fi
// ---------------------------------------------------------
static void wifi_event_handler(void* arg, esp_event_base_t event_base, int32_t event_id, void* event_data)
{
    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
        esp_wifi_connect();
    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
        esp_wifi_connect();
    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
        xEventGroupSetBits(s_wifi_event_group, WIFI_CONNECTED_BIT);
    }
}

static void wifi_init_sta(void)
{
    s_wifi_event_group = xEventGroupCreate();
    ESP_ERROR_CHECK(esp_netif_init());
    ESP_ERROR_CHECK(esp_event_loop_create_default());
    esp_netif_create_default_wifi_sta();

    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
    ESP_ERROR_CHECK(esp_wifi_init(&cfg));

    esp_event_handler_instance_t instance_any_id, instance_got_ip;
    ESP_ERROR_CHECK(esp_event_handler_instance_register(WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL, &instance_any_id));
    ESP_ERROR_CHECK(esp_event_handler_instance_register(IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL, &instance_got_ip));

    wifi_config_t wifi_config = { 0 };
    strncpy((char *)wifi_config.sta.ssid, s_active_cfg.ssid, sizeof(wifi_config.sta.ssid) - 1);
    strncpy((char *)wifi_config.sta.password, s_active_cfg.pass, sizeof(wifi_config.sta.password) - 1);

    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
    ESP_ERROR_CHECK(esp_wifi_start());
}

// ambil RSSI live dari AP yang lagi connect
static int wifi_get_rssi(void)
{
    wifi_ap_record_t ap_info;
    if (esp_wifi_sta_get_ap_info(&ap_info) == ESP_OK) {
        return ap_info.rssi;
    }
    return 0;
}

