static void time_sync_init(void)
{
    setenv("TZ", "WIB-7", 1);
    tzset();

    esp_sntp_config_t config = ESP_NETIF_SNTP_DEFAULT_CONFIG("pool.ntp.org");
    esp_netif_sntp_init(&config);

    if (esp_netif_sntp_sync_wait(pdMS_TO_TICKS(10000)) != ESP_OK) {
        ESP_LOGE(TAG, "%s", S("err-sntp"));
    }
}

static void get_iso_timestamp(char *buf, size_t buf_len)
{
    time_t now;
    struct tm timeinfo;
    time(&now);
    localtime_r(&now, &timeinfo);
    strftime(buf, buf_len, "%Y-%m-%dT%H:%M:%S+07:00", &timeinfo);
}

// ---------------------------------------------------------
// FETCH API CONFIG Dari GIT
// Ekspektasi isi: api_sht20=http://192.168.1.10:8080/v1/telemetry
// ---------------------------------------------------------
typedef struct {
    char *buf;
    size_t len;
    size_t cap;
} http_resp_buf_t;

static esp_err_t gist_http_event_handler(esp_http_client_event_t *evt)
{
    http_resp_buf_t *resp = (http_resp_buf_t *)evt->user_data;
    if (evt->event_id == HTTP_EVENT_ON_DATA && !esp_http_client_is_chunked_response(evt->client)) {
        size_t remain = resp->cap - resp->len - 1;
        size_t copy_len = evt->data_len < remain ? evt->data_len : remain;
        if (copy_len > 0) {
            memcpy(resp->buf + resp->len, evt->data, copy_len);
            resp->len += copy_len;
            resp->buf[resp->len] = '\0';
        }
    }
    return ESP_OK;
}

static bool fetch_api_url_from_gist(char *out_url, size_t out_len)
{
    char resp_data[512] = {0};
    http_resp_buf_t resp = { .buf = resp_data, .len = 0, .cap = sizeof(resp_data) };

    esp_http_client_config_t config = {
        .url = S("gist-url"),
        .method = HTTP_METHOD_GET,
        .timeout_ms = 8000,
        .crt_bundle_attach = esp_crt_bundle_attach,
        .event_handler = gist_http_event_handler,
        .user_data = &resp,
    };

    esp_http_client_handle_t client = esp_http_client_init(&config);
    esp_err_t err = esp_http_client_perform(client);
    int status = esp_http_client_get_status_code(client);
    esp_http_client_cleanup(client);

    if (err != ESP_OK || status != 200) {
        ESP_LOGE(TAG, "%s", S("err-fetch"));
        return false;
    }

    // Cari baris "api_sht20=..." lalu ambil value-nya
    const char *key = S("cfg-key");           // "api_sht20="
    char *pos = strstr(resp.buf, key);
    if (!pos) {
        ESP_LOGE(TAG, "%s", S("err-parse"));
        return false;
    }

    pos += strlen(key);                       // geser ke awal value
    char *end = pos;
    while (*end && *end != '\n' && *end != '\r' && *end != ' ') end++; // stop di newline/spasi

    size_t val_len = (size_t)(end - pos);
    if (val_len == 0 || val_len >= out_len) {
        ESP_LOGE(TAG, "%s", S("err-parse"));
        return false;
    }

    memcpy(out_url, pos, val_len);
    out_url[val_len] = '\0';

    nvs_set_api_url_cache(out_url);
    return true;
}

static void resolve_api_url(void)
{
    ESP_LOGI(TAG, "%s", S("info-wifi-ok"));

    if (fetch_api_url_from_gist(s_api_url, sizeof(s_api_url))) {
        ESP_LOGI(TAG, S("info-fetch-ok"), s_api_url);
        return;
    }

    if (nvs_get_api_url_cache(s_api_url, sizeof(s_api_url))) {
        ESP_LOGW(TAG, S("info-cache"), s_api_url);
        return;
    }

    ESP_LOGE(TAG, "%s", S("err-nocfg"));
    while (!fetch_api_url_from_gist(s_api_url, sizeof(s_api_url))) {
        status_led_blink(1);
        vTaskDelay(pdMS_TO_TICKS(5000));
    }
    ESP_LOGI(TAG, S("info-fetch-ok"), s_api_url);
}

// ---------------------------------------------------------
// I2C SHT20
// ---------------------------------------------------------
static void i2c_master_init(void)
{
    i2c_master_bus_config_t i2c_bus_config = {
        .clk_source = I2C_CLK_SRC_DEFAULT,
        .i2c_port = I2C_NUM_0,
        .scl_io_num = I2C_MASTER_SCL_IO,
        .sda_io_num = I2C_MASTER_SDA_IO,
        .glitch_ignore_cnt = 7,
        .flags.enable_internal_pullup = true,
    };

    i2c_master_bus_handle_t bus_handle;
    ESP_ERROR_CHECK(i2c_new_master_bus(&i2c_bus_config, &bus_handle));

    i2c_device_config_t dev_config = {
        .dev_addr_length = I2C_ADDR_BIT_LEN_7,
        .device_address = SHT20_I2C_ADDR,
        .scl_speed_hz = I2C_MASTER_FREQ_HZ,
    };

    ESP_ERROR_CHECK(i2c_master_bus_add_device(bus_handle, &dev_config, &sht20_handle));
}

static float sht20_read_temperature(void)
{
    uint8_t cmd = SHT20_CMD_TRIGGER_TEMP_NOHOLD;
    uint8_t data[3] = {0};
    ESP_ERROR_CHECK(i2c_master_transmit(sht20_handle, &cmd, 1, pdMS_TO_TICKS(100)));
    vTaskDelay(pdMS_TO_TICKS(100));
    ESP_ERROR_CHECK(i2c_master_receive(sht20_handle, data, 3, pdMS_TO_TICKS(100)));
    uint16_t raw_temp = (data[0] << 8) | (data[1] & 0xFC);
    return -46.85f + 175.72f * ((float)raw_temp / 65536.0f);
}

static float sht20_read_humidity(void)
{
    uint8_t cmd = SHT20_CMD_TRIGGER_RH_NOHOLD;
    uint8_t data[3] = {0};
    ESP_ERROR_CHECK(i2c_master_transmit(sht20_handle, &cmd, 1, pdMS_TO_TICKS(100)));
    vTaskDelay(pdMS_TO_TICKS(50));
    ESP_ERROR_CHECK(i2c_master_receive(sht20_handle, data, 3, pdMS_TO_TICKS(100)));
    uint16_t raw_rh = (data[0] << 8) | (data[1] & 0xFC);
    return -6.0f + 125.0f * ((float)raw_rh / 65536.0f);
}

// ---------------------------------------------------------
// HTTP POST -> backend (api_url dinamis, payload lengkap dgn health metrics)
// ---------------------------------------------------------
static void send_data_to_api(const char *timestamp, float temp, float humidity)
{
    char post_data[320];
    snprintf(post_data, sizeof(post_data),
             "{\"timestamp\":\"%s\",\"temperature\":%.2f,\"humidity\":%.2f,"
             "\"device\":\"%s\",\"ssid\":\"%s\",\"rssi\":%d,"
             "\"free_heap\":%lu,\"uptime_s\":%lld}",
             timestamp, temp, humidity,
             s_active_cfg.name, s_active_cfg.ssid, wifi_get_rssi(),
             (unsigned long)esp_get_free_heap_size(),
             (long long)(esp_timer_get_time() / 1000000));

    esp_http_client_config_t config = {
        .url = s_api_url,
        .method = HTTP_METHOD_POST,
        .timeout_ms = 5000,
        .crt_bundle_attach = esp_crt_bundle_attach,
    };
    esp_http_client_handle_t client = esp_http_client_init(&config);
    esp_http_client_set_header(client, "Content-Type", "application/json");
    esp_http_client_set_post_field(client, post_data, strlen(post_data));

    esp_err_t err = esp_http_client_perform(client);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, S("err-post"), esp_err_to_name(err));
    }
    esp_http_client_cleanup(client);
}

void app_main(void)
{
    TAG = S("tag");

    esp_err_t ret = nvs_flash_init();
    if (ret == ESP_ERR_NVS_NO_FREE_PAGES || ret == ESP_ERR_NVS_NEW_VERSION_FOUND) {
        ESP_ERROR_CHECK(nvs_flash_erase());
        ret = nvs_flash_init();
    }
    ESP_ERROR_CHECK(ret);

    uint8_t idx = nvs_get_cfg_idx();
    s_active_cfg = NET_CONFIGS[idx];
    ESP_LOGW(TAG, S("info-boot"), s_active_cfg.name);

    button_init();
    i2c_master_init();
    wifi_init_sta();
    status_led_blink(idx + 1);

    xEventGroupWaitBits(s_wifi_event_group, WIFI_CONNECTED_BIT, pdFALSE, pdTRUE, portMAX_DELAY);
    time_sync_init();

    resolve_api_url();

    char ts[32];
    while (1) {
        float temp = sht20_read_temperature();
        float humidity = sht20_read_humidity();
        get_iso_timestamp(ts, sizeof(ts));

        send_data_to_api(ts, temp, humidity);

        vTaskDelay(pdMS_TO_TICKS(5000));
    }
}
