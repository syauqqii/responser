    {"info-fetch-ok","Fetch OK -> api_url: %s"},
    {"info-switch",  ">>> Ganti Profile: %s (idx %d). Restarting..."},
    {"info-cache",   "Pakai cache api_url: %s"},
    {"err-wifi",     "WiFi connect gagal"},
    {"err-fetch",    "Fetch gagal, fallback ke cache NVS"},
    {"err-parse",    "Key api_sht20 tidak ditemukan di response"},
